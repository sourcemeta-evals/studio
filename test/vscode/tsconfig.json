{
  // TypeScript configuration for VS Code extension tests
  // Extends the Node.js configuration to inherit strict type checking rules
  // and adds test-specific settings
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    // Output directory for compiled test files
    // Tests are compiled separately from the main extension code
    "outDir": "../../build/test/vscode",
    // Type definitions for the test framework and VS Code API
    // Mocha: test framework
    // Node: Node.js built-in modules
    // @types/vscode: VS Code extension API types
    "types": ["mocha", "node", "@types/vscode"]
  },
  // Include all test files in this directory
  // This compiles all TypeScript files in the test suite
  "include": ["**/*"]
}
